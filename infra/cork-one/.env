# Parent NIC for VLAN subinterfaces and node1 trunk bridge
PARENT_IF=en0

# Host VLAN interfaces created by setup-host-vlans.sh
VLAN100_BRIDGE=vlan0
VLAN200_BRIDGE=vlan1

# Upstream networks for node1 (edit for your Mac)
UPSTREAM_IB_BRIDGE=en0
UPSTREAM_OOB_BRIDGE=en0

# node1 NIC2 trunk — bridged to parent, VLAN tagging in guest
TRUNK_BRIDGE=en0
