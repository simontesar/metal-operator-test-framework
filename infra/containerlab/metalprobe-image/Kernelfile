from: git://git.kernel.org/pub/scm/linux/kernel/git/stable/linux@v7.1
options:
  enable:
  - EFI
  - EFI_STUB
  - ACPI
  - PCI
  - NET
  - INET
  - IPV6
  - UNIX
  - NETDEVICES
  - BLK_DEV
  - BLK_DEV_INITRD
  - DEVTMPFS
  - DEVTMPFS_MOUNT
  - PROC_FS
  - SYSFS
  - TMPFS
  - PRINTK
  - TTY
  - SERIAL_8250
  - SERIAL_8250_CONSOLE
  - INPUT
  - INPUT_EVDEV
modules:
  builtin:
  - FAILOVER
  - NET_FAILOVER
  - VIRTIO
  - VIRTIO_PCI
  - VIRTIO_NET
  - VIRTIO_BLK
  - ACPI_BUTTON
