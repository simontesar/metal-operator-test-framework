# Parent device for VLAN subinterfaces and master's trunk bridge.
PARENT_IF=dummy0

# Host VLAN interfaces created by setup-host-vlans.sh
VLAN100_BRIDGE=vlan0
VLAN200_BRIDGE=vlan1

# Upstream networks for master's IB/OOB uplinks
UPSTREAM_IB_BRIDGE=dummy0
UPSTREAM_OOB_BRIDGE=dummy0

TRUNK_BRIDGE=dummy0
